{
  "name": ".NET 10 Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/copilot-cli": {}
  },
  "initializeCommand": "mkdir -p /tmp/aauth-empty-mount",
  "mounts": [
    "source=${localEnv:AAUTH_TS_SAMPLES:/tmp/aauth-empty-mount},target=/workspaces/aauth-samples,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.fontFamily": "MesloLGS NF, Menlo, Monaco, 'Courier New', monospace"
      }
    }
  },
  "postCreateCommand": "dotnet restore",
  "remoteUser": "root"
}